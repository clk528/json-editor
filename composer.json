{
    "name": "clk528/json-editor",
    "description": "JSON Editor for Laravel-admin",
    "type": "library",
    "keywords": ["laravel-admin", "extension"],
    "homepage": "https://github.com/clk528/json-editor",
    "license": "MIT",
    "authors": [
        {
            "name": "jxlwqq",
            "email": "jxlwqq@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "clk528/laravel-admin": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~6.0"
    },
    "autoload": {
        "psr-4": {
            "Jxlwqq\\JsonEditor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jxlwqq\\JsonEditor\\JsonEditorServiceProvider"
            ]

        }
    }
}
